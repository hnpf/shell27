#!/usr/bin/env python3
"""XDG Desktop Portal FileChooser backend powered by Finder."""

import os
import subprocess
import threading
import urllib.parse
from pathlib import Path

import dbus
import dbus.mainloop.glib
import dbus.service
from gi.repository import GLib

BUS_NAME = "org.freedesktop.impl.portal.desktop.finder"
OBJ_PATH = "/org/freedesktop/portal/desktop"
IFACE_FILE_CHOOSER = "org.freedesktop.impl.portal.FileChooser"
IFACE_REQUEST = "org.freedesktop.impl.portal.Request"

PICKER_BIN = str(Path(__file__).resolve().parent / "finder-picker")


def _ay_to_str(val):
    if val is None:
        return ""
    if isinstance(val, (bytes, bytearray)):
        raw = bytes(val)
    else:
        try:
            raw = bytes(int(b) for b in val)
        except Exception:
            return str(val)
    return raw.rstrip(b"\x00").decode("utf-8", errors="replace")


def _path_to_uri(p):
    return "file://" + urllib.parse.quote(p, safe="/")


class PortalRequest(dbus.service.Object):
    def __init__(self, bus, path):
        super().__init__(bus, path)
        self.proc = None
        self.cancelled = False

    @dbus.service.method(IFACE_REQUEST, in_signature="", out_signature="")
    def Close(self):
        self.cancelled = True
        if self.proc and self.proc.poll() is None:
            try:
                self.proc.terminate()
            except Exception:
                pass
        try:
            self.remove_from_connection()
        except Exception:
            pass


LOG_FILE = "/tmp/finder-portal.log"


def _log(msg):
    try:
        with open(LOG_FILE, "a", encoding="utf-8") as f:
            f.write(msg + "\n")
    except Exception:
        pass


class FinderPortal(dbus.service.Object):
    def __init__(self, bus):
        super().__init__(bus, OBJ_PATH)
        self.bus = bus
        _log(f"FinderPortal started, WAYLAND_DISPLAY={os.environ.get('WAYLAND_DISPLAY', '')}")

    def _run_picker(self, req, args):
        env = os.environ.copy()
        _log(f"Launching picker: {PICKER_BIN} {args}")
        try:
            with open(LOG_FILE, "a", encoding="utf-8") as lf:
                req.proc = subprocess.Popen(
                    [PICKER_BIN] + args,
                    stdout=subprocess.PIPE,
                    stderr=lf,
                    text=True,
                    env=env,
                    start_new_session=True,
                )
            out, _ = req.proc.communicate()
            _log(f"Picker exited rc={req.proc.returncode} out={out!r}")
            if req.cancelled or req.proc.returncode != 0:
                return []
            return [line.strip() for line in (out or "").splitlines() if line.strip()]
        except Exception as e:
            _log(f"Picker exception: {e}")
            return []
        finally:
            try:
                req.remove_from_connection()
            except Exception:
                pass

    @dbus.service.method(
        IFACE_FILE_CHOOSER,
        in_signature="osssa{sv}",
        out_signature="ua{sv}",
        async_callbacks=("reply_cb", "error_cb"),
    )
    def OpenFile(self, handle, app_id, parent_window, title, options, reply_cb, error_cb):
        req = PortalRequest(self.bus, str(handle))
        multiple = bool(options.get("multiple", False))
        directory = bool(options.get("directory", False))
        initial = _ay_to_str(options.get("current_folder"))

        args = []
        if directory:
            args.append("--folder")
        elif multiple:
            args.append("--multiple")
        else:
            args.append("--open")
        if title:
            args.extend(["--title", str(title)])
        if initial and os.path.isdir(initial):
            args.extend(["--initial", initial])

        def worker():
            paths = self._run_picker(req, args)
            if not paths:
                GLib.idle_add(reply_cb, dbus.UInt32(1), dbus.Dictionary({}, signature="sv"))
            else:
                uris = dbus.Array([_path_to_uri(p) for p in paths], signature="s")
                res = dbus.Dictionary({"uris": uris}, signature="sv")
                GLib.idle_add(reply_cb, dbus.UInt32(0), res)

        threading.Thread(target=worker, daemon=True).start()

    @dbus.service.method(
        IFACE_FILE_CHOOSER,
        in_signature="osssa{sv}",
        out_signature="ua{sv}",
        async_callbacks=("reply_cb", "error_cb"),
    )
    def SaveFile(self, handle, app_id, parent_window, title, options, reply_cb, error_cb):
        req = PortalRequest(self.bus, str(handle))
        current_name = str(options.get("current_name", ""))
        initial_folder = _ay_to_str(options.get("current_folder"))
        current_file = _ay_to_str(options.get("current_file"))
        if current_file and not initial_folder:
            initial_folder = os.path.dirname(current_file)
            if not current_name:
                current_name = os.path.basename(current_file)

        args = ["--save"]
        if title:
            args.extend(["--title", str(title)])
        if initial_folder and os.path.isdir(initial_folder):
            args.extend(["--initial", initial_folder])
        if current_name:
            args.extend(["--name", current_name])

        def worker():
            paths = self._run_picker(req, args)
            if not paths:
                GLib.idle_add(reply_cb, dbus.UInt32(1), dbus.Dictionary({}, signature="sv"))
            else:
                uris = dbus.Array([_path_to_uri(paths[0])], signature="s")
                res = dbus.Dictionary({"uris": uris}, signature="sv")
                GLib.idle_add(reply_cb, dbus.UInt32(0), res)

        threading.Thread(target=worker, daemon=True).start()

    @dbus.service.method(
        IFACE_FILE_CHOOSER,
        in_signature="osssa{sv}",
        out_signature="ua{sv}",
        async_callbacks=("reply_cb", "error_cb"),
    )
    def SaveFiles(self, handle, app_id, parent_window, title, options, reply_cb, error_cb):
        req = PortalRequest(self.bus, str(handle))
        initial_folder = _ay_to_str(options.get("current_folder"))
        raw_files = options.get("files", [])
        names = [_ay_to_str(f) for f in raw_files]

        args = ["--folder"]
        if title:
            args.extend(["--title", str(title)])
        if initial_folder and os.path.isdir(initial_folder):
            args.extend(["--initial", initial_folder])

        def worker():
            paths = self._run_picker(req, args)
            if not paths:
                GLib.idle_add(reply_cb, dbus.UInt32(1), dbus.Dictionary({}, signature="sv"))
            else:
                dest_dir = paths[0].rstrip("/")
                uris = dbus.Array([_path_to_uri(f"{dest_dir}/{n}") for n in names], signature="s")
                res = dbus.Dictionary({"uris": uris}, signature="sv")
                GLib.idle_add(reply_cb, dbus.UInt32(0), res)

        threading.Thread(target=worker, daemon=True).start()


def main():
    dbus.mainloop.glib.threads_init()
    dbus.mainloop.glib.DBusGMainLoop(set_as_default=True)
    bus = dbus.SessionBus()
    _name = dbus.service.BusName(BUS_NAME, bus)
    _portal = FinderPortal(bus)
    loop = GLib.MainLoop()
    loop.run()


if __name__ == "__main__":
    main()
